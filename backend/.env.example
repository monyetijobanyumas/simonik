# ============================================================
# SIMONIK Backend - Environment Variables (Example)
# ============================================================
# Copy file ini ke `.env` dan sesuaikan nilainya dengan
# konfigurasi lokal Anda.
# ============================================================

# Port server backend
PORT=3000

# Koneksi database PostgreSQL
# Format: postgres://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:PASSWORD_ANDA@localhost:5432/simonik

# Secret untuk JWT (ganti dengan string random di produksi)
JWT_SECRET=ganti_dengan_string_random_panjang

# Direktori upload foto (relatif dari folder backend)
UPLOAD_DIR=uploads